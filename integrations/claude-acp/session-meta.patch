+import { buildClaudeCodeOptionsMeta } from "../src/acp/agent-command.js";
+import {
+  mergeSessionOptions,
+  normalizeSessionOptionShape,
+  persistSessionOptions,
+  sessionOptionsFromRecord,
+} from "../src/runtime/engine/session-options.js";
+import { loadSessionMetaSpec, mergeSessionMeta, parseSessionMeta } from "../src/session-meta.js";
+import type { SessionRecord } from "../src/types.js";
+
+test("parseSessionMeta accepts JSON objects", () => {
+  assert.deepEqual(parseSessionMeta({ a: 1 }), { a: 1 });
+  assert.deepEqual(parseSessionMeta({}), {});
+});
+
+test("parseSessionMeta rejects non-object roots", () => {
+  for (const value of [null, undefined, "x", 3, [1, 2], true]) {
+    assert.throws(() => parseSessionMeta(value), /must be a JSON object/);
+  }
+});
+
+test("mergeSessionMeta deep-merges objects and replaces arrays and scalars", () => {
+  const merged = mergeSessionMeta(
+    {
+      claudeCode: { options: { settingSources: ["project", "local"], model: "m" } },
+      keep: { a: 1 },
+    },
+    {
+      claudeCode: { options: { settingSources: [] } },
+      keep: { b: 2 },
+      extra: [1, 2],
+    },
+  );
+
+  assert.deepEqual(merged, {
+    claudeCode: { options: { settingSources: [], model: "m" } },
+    keep: { a: 1, b: 2 },
+    extra: [1, 2],
+  });
+});
+
+test("mergeSessionMeta treats dangerous JSON keys as data, never prototypes", () => {
+  const base = JSON.parse('{"claudeCode":{"options":{"a":1}}}') as Record<string, unknown>;
+  const overlay = JSON.parse(
+    '{"__proto__":{"polluted":true},"constructor":{"x":1},"claudeCode":{"options":{"b":2}}}',
+  ) as Record<string, unknown>;
+
+  const merged = mergeSessionMeta(base, overlay);
+  assert(merged !== undefined);
+
+  assert.equal(({} as { polluted?: unknown }).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(merged), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(merged, "__proto__"), {
+    value: { polluted: true },
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+  assert.deepEqual(merged.constructor, { x: 1 });
+  assert.deepEqual(merged.claudeCode, { options: { a: 1, b: 2 } });
+});
+
+test("mergeSessionMeta does not alias base or overlay state", () => {
+  const overlay = { nested: { list: [1] } };
+  const merged = mergeSessionMeta(undefined, overlay);
+  overlay.nested.list.push(2);
+  assert.deepEqual(merged, { nested: { list: [1] } });
+});
+
+test("loadSessionMetaSpec parses inline JSON", async () => {
+  const meta = await loadSessionMetaSpec('{"agentProfile":{"tier":2}}', process.cwd());
+  assert.deepEqual(meta, { agentProfile: { tier: 2 } });
+});
+
+test("loadSessionMetaSpec resolves file paths against cwd", async (t) => {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), "acpx-meta-"));
+  t.after(() => fs.rm(dir, { recursive: true, force: true }));
+  await fs.writeFile(
+    path.join(dir, "meta.json"),
+    JSON.stringify({ claudeCode: { options: { persistSession: false } } }),
+  );
+
+  const meta = await loadSessionMetaSpec("meta.json", dir);
+  assert.deepEqual(meta, { claudeCode: { options: { persistSession: false } } });
+});
+
+test("loadSessionMetaSpec rejects malformed JSON and non-object roots", async (t) => {
+  await assert.rejects(loadSessionMetaSpec("{invalid", process.cwd()), SyntaxError);
+
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), "acpx-meta-"));
+  t.after(() => fs.rm(dir, { recursive: true, force: true }));
+  await fs.writeFile(path.join(dir, "array.json"), '["a"]');
+  await assert.rejects(loadSessionMetaSpec("array.json", dir), /must be a JSON object/);
+
+  assert.equal(await loadSessionMetaSpec(undefined, process.cwd()), undefined);
+  assert.equal(await loadSessionMetaSpec("  ", process.cwd()), undefined);
+});
+
+test("buildClaudeCodeOptionsMeta lets explicit meta override generated leaves", () => {
+  const meta = buildClaudeCodeOptionsMeta(
+    {
+      model: "sonnet",
+      meta: { claudeCode: { options: { settingSources: [] } } },
+    },
+    true,
+  );
+
+  assert.deepEqual(meta, {
+    claudeCode: { options: { settingSources: [], model: "sonnet" } },
+  });
+});
+
+test("buildClaudeCodeOptionsMeta forwards vendor-neutral namespaces untouched", () => {
+  const meta = buildClaudeCodeOptionsMeta(
+    {
+      meta: { agentProfile: { tier: "review", flags: ["a"] } },
+    },
+    false,
+  );
+
+  assert.deepEqual(meta, { agentProfile: { tier: "review", flags: ["a"] } });
+});
+
+test("mergeSessionOptions merges meta leaves with preferred winning", () => {
+  const merged = mergeSessionOptions(
+    { meta: { claudeCode: { options: { persistSession: false } } } },
+    { meta: { claudeCode: { options: { settingSources: [] } }, lane: "a" } },
+  );
+
+  assert.deepEqual(merged?.meta, {
+    claudeCode: { options: { settingSources: [], persistSession: false } },
+    lane: "a",
+  });
+});
+
+test("normalizeSessionOptionShape drops empty meta", () => {
+  assert.equal(normalizeSessionOptionShape({ meta: {} }), undefined);
+  assert.deepEqual(normalizeSessionOptionShape({ meta: { a: 1 } }), { meta: { a: 1 } });
+});
+
+test("session options meta round-trips through the persisted record", () => {
+  const record = {} as SessionRecord;
+  persistSessionOptions(record, {
+    meta: { claudeCode: { options: { settingSources: [] } }, agentProfile: { tier: 2 } },
+  });
+
+  assert.deepEqual(record.acpx?.session_options?.meta, {
+    claudeCode: { options: { settingSources: [] } },
+    agentProfile: { tier: 2 },
+  });
+  assert.deepEqual(sessionOptionsFromRecord(record), {
+    meta: { claudeCode: { options: { settingSources: [] } }, agentProfile: { tier: 2 } },
+  });
+});
+
+test("session options meta ignores malformed persisted values", () => {
+  const record = {
+    acpx: { session_options: { meta: ["not", "an", "object"] } },
+  } as unknown as SessionRecord;
+  assert.equal(sessionOptionsFromRecord(record), undefined);
+});
