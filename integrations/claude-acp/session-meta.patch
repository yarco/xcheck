diff --git a/src/session-meta.ts b/src/session-meta.ts
new file mode 100644
index 0000000..ba4e385
--- /dev/null
+++ b/src/session-meta.ts
@@ -0,0 +1,77 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+
+/**
+ * Vendor-neutral session metadata forwarded as `_meta` on session/new,
+ * session/load, and session/resume. Values must be JSON-serializable.
+ */
+export type SessionMeta = Record<string, unknown>;
+
+export function isSessionMetaRecord(value: unknown): value is SessionMeta {
+  return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+export function parseSessionMeta(value: unknown, source = "session meta"): SessionMeta {
+  if (!isSessionMetaRecord(value)) {
+    throw new Error(`${source}: session meta must be a JSON object`);
+  }
+  return value;
+}
+
+export function cloneSessionMeta(meta: SessionMeta): SessionMeta {
+  return structuredClone(meta);
+}
+
+/**
+ * Deep-merges explicit session metadata over generated metadata. Plain
+ * objects merge recursively; arrays and scalars replace. Overlay values win
+ * per leaf, so an explicit `[]` or scalar always beats a generated default.
+ */
+export function mergeSessionMeta(
+  base: SessionMeta | undefined,
+  overlay: SessionMeta | undefined,
+): SessionMeta | undefined {
+  if (!isSessionMetaRecord(base)) {
+    return isSessionMetaRecord(overlay) ? cloneSessionMeta(overlay) : undefined;
+  }
+  if (!isSessionMetaRecord(overlay)) {
+    return cloneSessionMeta(base);
+  }
+
+  const merged: SessionMeta = cloneSessionMeta(base);
+  for (const [key, overlayValue] of Object.entries(overlay)) {
+    // Arbitrary JSON keys include __proto__ and inherited names like
+    // constructor: read own values only and define the merged key as an
+    // enumerable own property so prototypes are never read or mutated.
+    const baseValue = Object.hasOwn(merged, key) ? merged[key] : undefined;
+    const mergedValue =
+      isSessionMetaRecord(baseValue) && isSessionMetaRecord(overlayValue)
+        ? mergeSessionMeta(baseValue, overlayValue)
+        : structuredClone(overlayValue);
+    Object.defineProperty(merged, key, {
+      value: mergedValue,
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    });
+  }
+  return merged;
+}
+
+export async function loadSessionMetaSpec(
+  spec: string | undefined,
+  cwd: string,
+): Promise<SessionMeta | undefined> {
+  const trimmed = spec?.trim();
+  if (!trimmed) {
+    return undefined;
+  }
+
+  if (trimmed.startsWith("{")) {
+    return parseSessionMeta(JSON.parse(trimmed), "--session-meta");
+  }
+
+  const metaPath = path.resolve(cwd, trimmed);
+  const raw = await fs.readFile(metaPath, "utf8");
+  return parseSessionMeta(JSON.parse(raw), metaPath);
+}
