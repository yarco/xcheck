diff --git a/test/integration.test.ts b/test/integration.test.ts
index e73387d..e8a2187 100644
--- a/test/integration.test.ts
+++ b/test/integration.test.ts
@@ -3053,0 +3054,54 @@ test("integration: --mcp-config loads session-scoped MCP servers", async () => {
+test("integration: --session-meta does not hide a following --mcp-config", async () => {
+  await withTempHome(async (homeDir) => {
+    const cwd = await fs.mkdtemp(path.join(os.tmpdir(), "acpx-meta-mcp-cwd-"));
+    const metaPath = path.join(homeDir, "job-meta.json");
+    const mcpConfigPath = path.join(homeDir, "job-mcp.json");
+    await fs.writeFile(metaPath, `${JSON.stringify({ vendor: { flag: true } })}\n`, "utf8");
+    await fs.writeFile(
+      mcpConfigPath,
+      `${JSON.stringify({
+        mcpServers: [
+          { name: "job-stdio", type: "stdio", command: "./bin/job-mcp", args: ["--serve"] },
+        ],
+      })}\n`,
+      "utf8",
+    );
+
+    try {
+      const result = await runCli(
+        [
+          "--agent",
+          MOCK_AGENT_COMMAND,
+          "--approve-all",
+          "--cwd",
+          cwd,
+          "--session-meta",
+          metaPath,
+          "--mcp-config",
+          mcpConfigPath,
+          "--format",
+          "json",
+          "exec",
+          "echo meta-mcp",
+        ],
+        homeDir,
+      );
+      assert.equal(result.code, 0, result.stderr);
+      const messages = parseJsonRpcOutputLines(result.stdout);
+      const newSessionRequest = messages.find(
+        (message) => message.method === "session/new" && extractJsonRpcId(message) !== undefined,
+      );
+      assert(newSessionRequest, `expected session/new request in output:\n${result.stdout}`);
+      const params = newSessionRequest.params as
+        | { mcpServers?: unknown; _meta?: { vendor?: { flag?: boolean } } }
+        | undefined;
+      assert.equal(params?._meta?.vendor?.flag, true);
+      assert.deepEqual(params?.mcpServers, [
+        { name: "job-stdio", command: "./bin/job-mcp", args: ["--serve"], env: [] },
+      ]);
+    } finally {
+      await fs.rm(cwd, { recursive: true, force: true });
+    }
+  });
+});
+
