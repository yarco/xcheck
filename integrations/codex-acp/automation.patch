diff --git a/src/__tests__/ephemeral-session.test.ts b/src/__tests__/ephemeral-session.test.ts
new file mode 100644
index 0000000..c3e1085
--- /dev/null
+++ b/src/__tests__/ephemeral-session.test.ts
@@ -0,0 +1,37 @@
+import {afterEach, describe, expect, it, vi} from "vitest";
+import {createCodexMockTestFixture, createTestModel} from "./acp-test-utils";
+import {TitleGenerator} from "../TitleGenerator";
+import type {CodexAppServerClient} from "../CodexAppServerClient";
+
+afterEach(() => vi.unstubAllEnvs());
+
+describe("ephemeral automation sessions", () => {
+    it.each([undefined, "0", "1"])("passes ephemeral only when explicitly enabled (%s)", async (value) => {
+        vi.stubEnv("CODEX_ACP_EPHEMERAL", value);
+        const fixture = createCodexMockTestFixture();
+        const appServer = fixture.getCodexAppServerClient();
+        const client = fixture.getCodexAcpClient();
+        const start = vi.spyOn(appServer, "threadStart").mockResolvedValue({
+            thread: {id: "automation-thread"}, model: "gpt-6.1-sol", reasoningEffort: "high",
+        } as never);
+        vi.spyOn(client, "fetchAvailableModels").mockResolvedValue([
+            createTestModel({id: "gpt-6.1-sol", model: "gpt-6.1-sol"}),
+        ]);
+        await client.newSession({cwd: "/fixture", mcpServers: []});
+        expect(start.mock.calls[0]![0].ephemeral).toBe(value === "1" ? true : undefined);
+    });
+
+    it("does not start a title model turn for an ephemeral session", async () => {
+        vi.stubEnv("CODEX_ACP_EPHEMERAL", "1");
+        const threadStart = vi.fn().mockResolvedValue({thread: {id: "title-thread"}});
+        const runTurn = vi.fn().mockResolvedValue({turn: {items: []}});
+        const generator = new TitleGenerator(
+            {threadStart, runTurn} as unknown as CodexAppServerClient,
+            "automation-thread", "/fixture", () => "unset",
+        );
+        generator.onTurnCompleted("review packet");
+        await generator.waitForIdle(1_000);
+        expect(threadStart).not.toHaveBeenCalled();
+        expect(runTurn).not.toHaveBeenCalled();
+    });
+});
