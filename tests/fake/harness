#!/usr/bin/env python3
"""Fake codex/claude/grok/agy/opencode/devin: speaks each CLI's real stream shape.

The kind is argv[0]'s basename. FAKE_MODE selects the behaviour:
ok | invalid | declined | error | hang | silent-exit | noop-frames | limit | limit-echo.
"""

import json
import os
import sys
import time
from pathlib import Path

kind = Path(sys.argv[0]).name
mode = os.environ.get("FAKE_MODE", "ok")
argv = sys.argv[1:]

if kind == "grok" and mode == "socket-symlink" and argv[argv.index("--sandbox") + 1] != "off":
    sys.stderr.write((Path(__file__).resolve().parent.parent / "fixtures/grok-sandbox-refusal.stderr").read_text())
    sys.exit(1)
if kind == "grok" and argv[-2:] == ["version", "--json"]:
    assert argv[argv.index("--sandbox") + 1] == "off"
    print(json.dumps({"currentVersion": "fixture-version", "channel": "stable"}))
    sys.exit(0)


def emit(obj):
    print(json.dumps(obj), flush=True)


# Quota meters (xcheck/capacity.py), FAKE_CAPACITY=eligible|reserve-low.
used = {"eligible": 40, "reserve-low": 95}[os.environ.get("FAKE_CAPACITY", "eligible")]
if kind == "codex" and argv[:1] == ["app-server"]:
    for line in sys.stdin:  # stays open until answered, like the real server
        msg = json.loads(line)
        if msg.get("id") == 1:
            emit({"id": 1, "result": {}})
        elif msg.get("id") == 2:
            emit({"id": 2, "result": {"rateLimits": {
                "primary": {"usedPercent": used, "windowDurationMins": 300},
                "secondary": {"usedPercent": 10, "windowDurationMins": 10080}}}})
    sys.exit(0)
if kind == "agy" and argv == ["--version"]:
    print("1.2.12")
    sys.exit(0)
if kind == "agy" and argv[:2] == ["-p", "/usage"]:
    bucket = lambda i, left: {"id": i, "remaining_fraction": left}
    emit({"status": "SUCCESS", "num_turns": 0, "command": {"name": "usage", "data": {"groups": [
        {"buckets": [bucket("gemini-weekly", (100 - used) / 100), bucket("gemini-5h", 1)]},
        {"buckets": [bucket("3p-weekly", 0.5), bucket("3p-5h", 1)]}]}}})
    sys.exit(0)


if kind == "claude":
    work = Path(argv[argv.index("--add-dir") + 1])
elif kind == "grok":
    work = Path(argv[argv.index("--cwd") + 1])
else:
    work = Path.cwd()
token = [l for l in (work / "evidence/manifest-tail.txt").read_text().splitlines() if l.strip()][-1]
answer = {
    "ok": f"### 1) VERDICT\nThe claim holds; the parser handles it.\n\n6) PROOF: {token}\nRESULT_COMPLETE\n",
    "invalid": "### 1) VERDICT\nfine but no proof and no marker\n",
    "declined": "I cannot do this review.\nRESULT_INVALID\n",
    "echo402": f"### 1) VERDICT\nThe packet quotes `HTTP 402 payment required` and `session limit reached`; both are evidence, not errors.\n6) PROOF: {token}\nRESULT_COMPLETE\n",
    "answer-exit": None,
    "slow": f"### 1) VERDICT\nThe claim holds after a slow read.\n6) PROOF: {token}\nRESULT_COMPLETE\n",
}.get(mode)
answer_ok = f"### 1) VERDICT\nThe claim holds; the parser handles it.\n\n6) PROOF: {token}\nRESULT_COMPLETE\n"
if mode == "socket-symlink":
    answer = answer_ok
upstream_limit = "[ModelRun] qwen/qwen3.8-27b:free is temporarily rate-limited upstream. Please retry shortly."
if mode == "echo-upstream-limit":
    answer = answer_ok.replace("The claim holds", "The packet quotes " + upstream_limit)
if mode == "slow":
    time.sleep(4)

if os.environ.get("FAKE_ENV_DUMP"):
    Path(os.environ["FAKE_ENV_DUMP"]).with_suffix(f".{kind}.json").write_text(json.dumps(dict(os.environ)))

# Interactive (TUI) invocations: the app writes ANSWER.md in its cwd, then idles
# like a real TUI waiting for the next prompt.
tui = {"claude": "-p" not in argv, "codex": "exec" not in argv,
       "grok": "--prompt-file" not in argv, "agy": "-i" in argv, "opencode": "run" not in argv,
       "devin": "-p" not in argv and "--print" not in argv}[kind]
if tui:
    print(f"\x1b[2J\x1b[H\x1b[1mfake {kind} TUI\x1b[0m\r\nworking on the review…\r", flush=True)
    target = Path(argv[argv.index("-C") + 1]) if kind == "codex" else Path.cwd()
    if mode == "silent-work":
        time.sleep(float(os.environ.get("FAKE_DELAY", "7")))
        (target / "ANSWER.md").write_text(answer_ok)
    elif mode == "deadline-rewrite":
        (target / "ANSWER.md").write_text(answer_ok.replace("The claim holds", "EARLY candidate"))
        time.sleep(4)
        (target / "ANSWER.md").write_text(answer_ok.replace("The claim holds", "EARLY candidate revised"))
        time.sleep(2)
        (target / "ANSWER.md").write_text(answer_ok.replace("The claim holds", "FINAL reviewed answer"))
    elif mode == "drawing-hang":
        while True:
            print("working animation", flush=True)
            time.sleep(0.2)
    elif mode == "error":
        print("You've hit your limit · resets 7pm\r", flush=True)
    elif mode == "slowwrite":
        (target / "ANSWER.md").write_text("### 1) VERDICT\npartial draft")
        time.sleep(2)
        (target / "ANSWER.md").write_text(f"### 1) VERDICT\nThe claim holds after a rewrite.\n6) PROOF: {token}\nRESULT_COMPLETE\n")
    elif mode == "answer-exit":  # agy: writes its answer, then its app exits by itself
        (target / "ANSWER.md").write_text(answer_ok)
        (target / "ANSWER.ready").write_text("ANSWER_READY\n")
        sys.exit(0)
    elif mode == "bg-child":
        child = os.fork()
        if child == 0:
            import signal
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            signal.signal(signal.SIGHUP, signal.SIG_IGN)
            while True:
                time.sleep(1)
        (target / "background-child.pid").write_text(str(child))
        (target / "ANSWER.md").write_text(answer_ok)
    elif mode == "noop-frames":  # devin blocked on a permission dialog: empty frames, no text
        for _ in range(300):
            sys.stdout.write("\x1b[?2026h\x1b[?25l\x1b[?2026l")
            sys.stdout.flush()
            time.sleep(0.2)
    elif mode == "limit":  # the real Agy per-model cap screen, then nothing
        sys.stdout.buffer.write((Path(__file__).resolve().parent.parent / "fixtures" / "agy-quota.screen").read_bytes())
        sys.stdout.flush()
    elif mode == "quoted-limit-silent":
        print('• "You\'ve hit your limit · resets 7pm"', flush=True)
        time.sleep(float(os.environ.get("FAKE_DELAY", "20")))
        (target / "ANSWER.md").write_text(answer_ok)
    elif mode == "native-limit-exit":
        print("Individual quota reached", flush=True)
        sys.exit(1)
    elif mode == "limit-echo":  # a peer quoting the banner while it keeps working
        print("\u26a0 Individual quota reached. Please upgrade your subscription to increase\r", flush=True)
        for i in range(20):
            print(f"thinking {i}s\r", flush=True)
            time.sleep(1)
        (target / "ANSWER.md").write_text(answer_ok)
    elif mode != "hang":
        (target / "ANSWER.md").write_text(answer or "")
    if mode not in ("hang", "error", "invalid", "noop-frames", "limit"):
        (target / "ANSWER.ready").write_text("ANSWER_READY\n")
    time.sleep(60)
    sys.exit(0)

if mode == "mixed-duration":
    mode = "buffered-work"
if mode == "buffered-work":
    emit({"type": "step_start", "sessionID": "ses_fake", "part": {"type": "step-start"}})
    emit({"type": "tool_use", "part": {"tool": "bash", "state": {"status": "running", "input": {"command": "SECRET command"}}}})
    delay = float(os.environ.get("FAKE_DELAY", "7"))
    time.sleep(delay if kind == "opencode" else delay / 8)
    answer = answer_ok
if mode in ("terminal-hang", "text-only", "codex-unflushed"):
    answer = answer_ok

if mode == "hang":
    time.sleep(60)
    sys.exit(0)
if mode == "silent-exit":
    sys.exit(0)
if mode == "error-retry":
    errors = {
        "codex": {"type": "error", "message": "status 402: usage limit reached"},
        "claude": {"type": "result", "subtype": "success", "is_error": True,
                   "result": "You've hit your limit · resets 7pm"},
        "grok": {"type": "error", "message": "HTTP 402 Grok Build usage balance exhausted"},
        "opencode": {"type": "error", "error": {"data": {"message": upstream_limit}}},
    }
    emit(errors[kind])
    if kind == "codex":
        emit({"type": "turn.failed", "error": {"message": errors[kind]["message"]}})
    while True:
        emit({"type": "heartbeat"})
        time.sleep(0.2)

if kind == "codex":
    out = Path(argv[argv.index("-o") + 1])
    emit({"type": "thread.started", "thread_id": "t"})
    if mode == "reconnect":
        emit({"type": "error", "message": "Reconnecting... 1/5 (stream disconnected before completion)"})
        time.sleep(1)
        answer = answer_ok
    if mode == "error":
        emit({"type": "error", "message": "status 402: usage limit reached"})
        emit({"type": "turn.failed", "error": {"message": "usage limit reached"}})
        sys.exit(1)
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": answer}})
    out.write_text(os.environ.get("FAKE_PARTIAL", "") if mode == "codex-unflushed" else answer)
    emit({"type": "turn.completed"})
    if mode == "codex-unflushed":
        time.sleep(60)
elif kind == "claude":
    if mode in ("mcp-policy-probe", "mcp-policy-audit", "mcp-startup-warning"):
        config_arg = argv[argv.index("--mcp-config") + 1]
        config = json.loads(config_arg) if config_arg.startswith('{') else json.loads(Path(config_arg).read_text())
        offered = set(config.get('mcpServers', {}))
        if '--strict-mcp-config' not in argv:
            offered.add('cloudflare-browser-rendering')  # a fake global connector
        emit({'type': 'system', 'subtype': 'init', 'mcp_servers':
              [{'name': name, 'status': 'connected'} for name in sorted(offered)]})
        if mode == 'mcp-policy-audit' or 'cloudflare-browser-rendering' in offered:
            fixture = Path(__file__).resolve().parent.parent / 'fixtures' / 'claude-cloudflare-call.json'
            for row in json.loads(fixture.read_text()):
                block = row['tool'] if row['stream_type'] == 'assistant' else row['tool_result']
                emit({'type': row['stream_type'], 'message': {'content': [block]}})
        if mode == 'mcp-startup-warning':
            emit({'type': 'system', 'subtype': 'init', 'mcp_servers':
                  [{'name': 'optional-fake', 'status': 'needs-auth'}]})
        answer = answer_ok
    emit({"type": "system", "subtype": "init"})
    if mode == "error":
        emit({"type": "result", "subtype": "success", "is_error": True,
              "result": "You've hit your limit · resets 7pm"})
        sys.exit(1)
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": answer}]}})
    emit({"type": "result", "subtype": "success", "is_error": False, "result": answer})
elif kind == "grok":
    if mode == "error":
        emit({"type": "error", "message": "HTTP 402 Grok Build usage balance exhausted"})
        sys.exit(1)
    emit({"type": "text", "data": "Let me read the files."})
    emit({"type": "tool_call", "toolName": "read_file", "rawInput": {"target_file": "PACKET.md"}})
    for i in range(0, len(answer), 7):
        emit({"type": "text", "data": answer[i:i + 7]})
    emit({"type": "end", "stopReason": "end_turn"})
elif kind == "opencode":
    part = lambda **p: {"type": "text", "part": {"type": "text", **p}}
    emit({"type": "step_start", "part": {"type": "step-start"}})
    if mode == "error-no-newline":
        emit(part(text=answer_ok))
        sys.stdout.write(json.dumps({"type": "error", "error": {"data": {"message": upstream_limit}}}))
        sys.stdout.flush()
        os.close(1)
        time.sleep(60)
        sys.exit(1)
    if mode == "rate-limit-retry":
        fixture = Path(__file__).resolve().parent.parent / "fixtures" / "opencode-qwen-rate-limit.jsonl"
        emit(json.loads(fixture.read_text()))
        while True:
            emit({"type": "step_start", "part": {"type": "step-start"}})
            time.sleep(0.2)
    if mode == "error":
        emit({"type": "error", "error": {"name": "APIError", "data": {"message": "FreeUsageLimitError: free usage exceeded"}}})
        sys.exit(1)
    emit(part(text="I will read the packet first."))
    emit({"type": "tool_use", "part": {"type": "tool", "tool": "read", "state": {"status": "completed", "input": {"filePath": "PACKET.md"}}}})
    emit(part(text=answer))
    if mode != "text-only":
        emit({"type": "step_finish", "part": {"type": "step-finish", "reason": "stop"}})
elif kind == "agy":
    sys.stdin.read()
    emit({"event": "init", "init": {}})
    if mode == "error":
        emit({"event": "result", "result": {"status": "ERROR", "response": "",
                                             "error": "Individual quota reached"}})
        sys.exit(1)
    emit({"event": "result", "result": {"status": "SUCCESS", "response": answer}})

if mode == "terminal-hang":
    time.sleep(60)
